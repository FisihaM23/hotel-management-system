# Resend API Key for Transactional Emails
Resend_API_KEY=re_your_api_key_here

# ── RESEND CUSTOM DOMAIN CONFIGURATION ──────────────────────────────────────
# RESEND_FROM_EMAIL=Grand 6-Floor Hotel & Resort <welcome@yourhotel.com>

# ── OPTIONAL DIRECT SMTP FALLBACK (e.g., Gmail App Password) ───────────────
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM=your_email@gmail.com
# SMTP_NAME=Grand 6-Floor Hotel & Resort Park

# ── DATABASE CONFIGURATION ──────────────────────────────────────────────────
# In production, use a dedicated application user with restricted privileges (SELECT, INSERT, UPDATE, DELETE).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotel_management
DB_USER=hms_app_user
DB_PASS=secure_strong_db_password_here

# ── INSTALLER PROTECTION TOKEN ──────────────────────────────────────────────
INSTALLER_TOKEN=generate_strong_random_token_here

# ── CORS ALLOWED ORIGINS CONFIGURATION ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://grandhotel.et,https://www.grandhotel.et

